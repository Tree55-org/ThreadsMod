{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://threadsmod.local/schemas/rewrite-set.schema.json",
  "title": "Exact-count idempotent rewrite set",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "rules"],
  "properties": {
    "schemaVersion": { "const": 1 },
    "rules": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/rule" }
    }
  },
  "$defs": {
    "rule": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "path", "expectedCount"],
      "properties": {
        "id": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]*$" },
        "path": { "type": "string", "minLength": 1 },
        "before": { "type": "string", "minLength": 1 },
        "after": { "type": "string", "minLength": 1 },
        "beforeFile": { "type": "string", "minLength": 1 },
        "afterFile": { "type": "string", "minLength": 1 },
        "expectedCount": { "type": "integer", "minimum": 1 }
      },
      "oneOf": [
        {
          "required": ["before", "after"],
          "not": {
            "anyOf": [
              { "required": ["beforeFile"] },
              { "required": ["afterFile"] }
            ]
          }
        },
        {
          "required": ["beforeFile", "afterFile"],
          "not": {
            "anyOf": [
              { "required": ["before"] },
              { "required": ["after"] }
            ]
          }
        }
      ]
    }
  }
}
