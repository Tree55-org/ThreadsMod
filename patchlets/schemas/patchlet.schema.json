{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://threadsmod.local/schemas/patchlet.schema.json",
  "title": "Threads Mod patchlet",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "$schema",
    "schemaVersion",
    "id",
    "revision",
    "title",
    "summary",
    "stage",
    "dependsOn",
    "resolution",
    "risk",
    "ownership",
    "inputs",
    "operations",
    "preconditions",
    "postconditions",
    "releaseGates",
    "ai"
  ],
  "properties": {
    "$schema": { "type": "string", "minLength": 1 },
    "schemaVersion": { "const": 1 },
    "id": { "$ref": "#/$defs/id" },
    "revision": { "type": "integer", "minimum": 1 },
    "title": { "type": "string", "minLength": 1 },
    "summary": { "type": "string", "minLength": 1 },
    "stage": {
      "enum": ["prepare", "rewrite", "compile", "render", "hook", "verify"]
    },
    "dependsOn": {
      "type": "array",
      "uniqueItems": true,
      "items": { "$ref": "#/$defs/id" }
    },
    "resolution": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "required",
        "binding",
        "sourceSha256Pointer",
        "requiredSections",
        "rewriteSets"
      ],
      "properties": {
        "required": { "type": "boolean" },
        "binding": {
          "enum": [
            "exact-apk-sha256",
            "exact-split-set-and-derived-apk-sha256"
          ]
        },
        "sourceSha256Pointer": { "const": "/source/sha256" },
        "requiredSections": {
          "type": "array",
          "uniqueItems": true,
          "items": { "type": "string", "minLength": 1 }
        },
        "rewriteSets": {
          "type": "array",
          "uniqueItems": true,
          "items": { "type": "string", "pattern": "^[^/]+\\.json$" }
        }
      }
    },
    "risk": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "enum": [
          "application-identity",
          "network-read",
          "network-write",
          "network-routing",
          "credential-storage",
          "native-code",
          "vpn-service",
          "personal-data",
          "dormant-network-write-boundary",
          "account-mutation",
          "private-api",
          "lifecycle-hook",
          "user-interface",
          "settings-storage",
          "inline-feed-hook",
          "packaging",
          "signing"
        ]
      }
    },
    "ownership": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "classPrefixes",
        "classDescriptors",
        "rewriteRuleIds",
        "manifestComponents",
        "hostHooks",
        "preferenceKeys",
        "databaseSchemas"
      ],
      "properties": {
        "classPrefixes": {
          "type": "array",
          "uniqueItems": true,
          "items": { "type": "string", "minLength": 1 }
        },
        "classDescriptors": {
          "type": "array",
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/descriptor" }
        },
        "rewriteRuleIds": {
          "type": "array",
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/id" }
        },
        "manifestComponents": {
          "type": "array",
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/javaClass" }
        },
        "hostHooks": {
          "type": "array",
          "uniqueItems": true,
          "items": { "type": "string", "minLength": 1 }
        },
        "preferenceKeys": {
          "type": "array",
          "uniqueItems": true,
          "items": { "type": "string", "minLength": 1 }
        },
        "databaseSchemas": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "pattern": "^(database|schema|migration|table|index):[a-z0-9_.-]+(?::[a-z0-9_.-]+)?$"
          }
        },
        "archiveTransforms": {
          "type": "array",
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/id" }
        },
        "semanticProofIds": {
          "type": "array",
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/id" }
        }
      }
    },
    "inputs": {
      "type": "array",
      "items": { "$ref": "#/$defs/input" }
    },
    "operations": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/operation" }
    },
    "preconditions": {
      "type": "array",
      "items": { "$ref": "#/$defs/condition" }
    },
    "postconditions": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/condition" }
    },
    "releaseGates": {
      "type": "array",
      "uniqueItems": true,
      "items": { "$ref": "#/$defs/id" }
    },
    "ai": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "allowed",
        "taskTemplate",
        "output",
        "mayEditProductionTree",
        "mayRelaxChecks"
      ],
      "properties": {
        "allowed": { "type": "boolean" },
        "taskTemplate": { "type": ["string", "null"] },
        "output": { "const": "proposal-json-only" },
        "mayEditProductionTree": { "const": false },
        "mayRelaxChecks": { "const": false }
      }
    }
  },
  "$defs": {
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9-]*$"
    },
    "sha256": {
      "type": "string",
      "pattern": "^(?!0{64}$)[0-9a-f]{64}$"
    },
    "descriptor": {
      "type": "string",
      "pattern": "^L[^;]+;$"
    },
    "javaClass": {
      "type": "string",
      "pattern": "^[A-Za-z_][A-Za-z0-9_]*(\\.[A-Za-z_][A-Za-z0-9_]*)+$"
    },
    "input": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "kind", "required"],
      "properties": {
        "id": { "$ref": "#/$defs/id" },
        "kind": {
          "enum": [
            "asset-file",
            "asset-tree",
            "resolution-section",
            "resolution-rewrite-set",
            "decoded-apk",
            "built-apk",
            "split-source-set",
            "derived-apk"
          ]
        },
        "path": { "type": "string", "minLength": 1 },
        "pathFromResolution": { "type": "string", "minLength": 1 },
        "pointer": { "type": "string", "pattern": "^/" },
        "sha256": { "$ref": "#/$defs/sha256" },
        "sha256FromResolution": { "type": "string", "pattern": "^/" },
        "required": { "type": "boolean" }
      },
      "allOf": [
        {
          "anyOf": [
            { "required": ["path"] },
            { "required": ["pathFromResolution"] },
            { "required": ["pointer"] }
          ]
        }
      ]
    },
    "operation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "type", "target", "idempotency"],
      "properties": {
        "id": { "$ref": "#/$defs/id" },
        "type": {
          "enum": [
            "exact-rewrite-set",
            "java-to-smali",
            "render-smali-templates",
            "exact-anchor-rewrite-set",
            "copy-native-library",
            "copy-license-asset",
            "deterministic-split-merge",
            "release-gate-suite"
          ]
        },
        "source": { "type": "string", "minLength": 1 },
        "sources": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "type": "string", "minLength": 1 }
        },
        "target": { "type": "string", "minLength": 1 },
        "bindingsPointer": { "type": "string", "pattern": "^/" },
        "destination": { "type": "string", "minLength": 1 },
        "templateNames": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "type": "string", "pattern": "^[^/]+\\.smali\\.tmpl$" }
        },
        "expectedCount": {
          "oneOf": [
            { "type": "integer", "minimum": 0 },
            { "const": "per-rule" }
          ]
        },
        "idempotency": {
          "enum": [
            "before-xor-after",
            "class-set-and-content-hash",
            "rendered-content-hash",
            "file-content-hash",
            "deterministic-output-hash",
            "read-only"
          ]
        },
        "discardClasses": {
          "type": "array",
          "uniqueItems": true,
          "items": { "type": "string", "minLength": 1 }
        },
        "verifyNoPlaceholders": { "type": "boolean" },
        "orderedGates": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/id" }
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "type": {
                "enum": ["copy-native-library", "copy-license-asset"]
              }
            },
            "required": ["type"]
          },
          "then": {
            "required": ["source"],
            "properties": {
              "idempotency": { "const": "file-content-hash" }
            }
          }
        }
      ]
    },
    "condition": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "check"],
      "properties": {
        "id": { "$ref": "#/$defs/id" },
        "check": { "type": "string", "minLength": 1 },
        "path": { "type": "string", "minLength": 1 },
        "pointer": { "type": "string", "pattern": "^/" },
        "value": {},
        "expectedCount": {
          "oneOf": [
            { "type": "integer", "minimum": 0 },
            { "const": "per-rule" }
          ]
        },
        "severity": { "enum": ["error", "warning"] }
      }
    }
  }
}
