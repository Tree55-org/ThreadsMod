{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://threadsmod.local/schemas/ai-task.schema.json",
  "title": "Bounded AI patchlet-resolution task",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "$schema",
    "schemaVersion",
    "taskId",
    "kind",
    "source",
    "roles",
    "candidates",
    "evidence",
    "authority",
    "constraints",
    "expectedOutputSchema"
  ],
  "properties": {
    "$schema": { "type": "string", "minLength": 1 },
    "schemaVersion": { "const": 1 },
    "taskId": { "$ref": "#/$defs/id" },
    "kind": {
      "enum": [
        "resolve-identity",
        "resolve-native-block-bridge",
        "resolve-main-activity-hooks",
        "resolve-drawer-settings",
        "resolve-inline-action-row",
        "resolve-inline-report",
        "resolve-socks5-proxy",
        "review-release-drift",
        "propose-feature"
      ]
    },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": ["apkSha256", "versionName", "decodedRoot"],
      "properties": {
        "apkSha256": { "$ref": "#/$defs/sha256" },
        "versionName": { "type": "string", "minLength": 1 },
        "decodedRoot": { "type": "string", "minLength": 1 }
      }
    },
    "roles": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": { "$ref": "#/$defs/id" }
    },
    "candidates": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "role", "descriptor", "evidenceIds"],
        "properties": {
          "id": { "$ref": "#/$defs/id" },
          "role": { "$ref": "#/$defs/id" },
          "descriptor": { "type": "string", "minLength": 1 },
          "path": { "type": "string", "minLength": 1 },
          "evidenceIds": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": { "$ref": "#/$defs/id" }
          }
        }
      }
    },
    "evidence": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "kind", "value"],
        "properties": {
          "id": { "$ref": "#/$defs/id" },
          "kind": { "type": "string", "minLength": 1 },
          "path": { "type": "string", "minLength": 1 },
          "value": { "type": "string", "minLength": 1 }
        }
      }
    },
    "authority": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "maySelectCandidateIds",
        "mayEditProductionTree",
        "mayRelaxChecks",
        "mayPublishArtifact"
      ],
      "properties": {
        "maySelectCandidateIds": { "const": true },
        "mayEditProductionTree": { "const": false },
        "mayRelaxChecks": { "const": false },
        "mayPublishArtifact": { "const": false }
      }
    },
    "constraints": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": { "type": "string", "minLength": 1 }
    },
    "expectedOutputSchema": {
      "const": "schemas/ai-resolution.schema.json"
    }
  },
  "$defs": {
    "id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$"
    },
    "sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    }
  }
}
