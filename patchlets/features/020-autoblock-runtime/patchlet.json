      "table:blocklist_targets_v2:retired-empty",
      "table:blocklist_metadata_v2:retired-empty"
    ]
  },
  "inputs": [
    {
      "id": "autoblock-java",
      "kind": "asset-tree",
      "path": "assets/autoblock/java",
      "sha256FromResolution": "/assets/autoblockJavaTreeSha256",
      "required": true
    },
    {
      "id": "eddsa-library",
      "kind": "asset-file",
      "path": "assets/autoblock/lib/net-i2p-crypto-eddsa-0.3.1.jar",
      "sha256": "3bc2c8922a52de7ecad21e9a34d2594b473f18598b7a2b8bd7d4b68ed6cc4dbf",
      "required": true
    },
    {
      "id": "smali-carrier",
      "kind": "asset-file",
      "path": "assets/autoblock/stub/smali-carrier.apk",
      "sha256FromResolution": "/assets/smaliCarrierSha256",
      "required": true
    },
    {
      "id": "runtime-host-tests",
      "kind": "asset-tree",
      "path": "assets/tests",
      "required": true
    }
  ],
  "operations": [
    {
      "id": "compile-runtime-to-smali",
      "type": "java-to-smali",
      "sources": [
        "assets/autoblock/java/threadsmod/autoblock",
        "assets/autoblock/java/threadsmod/bootstrap",
        "assets/autoblock/lib/net-i2p-crypto-eddsa-0.3.1.jar"
      ],
      "target": "decoded-apk:primary-dex",
      "idempotency": "class-set-and-content-hash",
      "discardClasses": ["threadsmod/autoblock/ThreadsBlockBridge"]
    }
  ],
  "preconditions": [
