{
  "$schema": "../../schemas/patchlet.schema.json",
  "schemaVersion": 1,
  "id": "020-autoblock-runtime",
  "revision": 24,
  "title": "Indexed passive Clone Blocker runtime",
  "summary": "Compile the stable Java runtime, freshest-verified allowlisted-mirror chunked v3 signed-root refresh (GitHub raw, jsDelivr, and AWS are all consulted for the signed root and the strictly newest root wins; its hash-bound group tables and gzip NDJSON chunks are fetched from the same three bases through pattern-validated object names, proven by SHA-256 before any parse, stream-parsed row by row into a content-addressed staging table, and only chunks whose signed name changed are downloaded) with exception-safe exact-Long durable 10-minute not-before reads and rejection-time re-advance, whole-chunk rejection of malformed rows, a per-bucket atomically replaced SQLite ID/username index (schema v3: h32 bucket column and index, UNIQUE normalized-username index, chunk/group/staging tables) with exact per-replaced-bucket new-ID metadata and reviewed v1-to-v2-to-v3 migration that retains the verified generation in fresh tables, tri-state observed-generation failures, main-thread authority grants with lock-serialized off-main revocation, one visible target per manual-first scheduler drain, exact-SHA native already-blocked preflight, repeated final authority checks before passive-running persistence, passive delay reservation and bridge dispatch, exactly one atomic 2-60 / 3-60 second passive delay pair, uncapped and unpaced manual inline work, conservative non-clearing passive deadlines after reservation, bounded live refresh/index/inline-render status, the shared automatic/manual single-flight scheduler with durable interrupted-passive review, and stable bootstrap arbitration for patchlet 085 whose no-update continuation is an empty Runnable that shows no UI.",
  "stage": "compile",
  "dependsOn": ["010-clone-identity"],
  "resolution": {
    "required": true,
    "binding": "exact-apk-sha256",
    "sourceSha256Pointer": "/source/sha256",
    "requiredSections": ["source", "assets", "release"],
    "rewriteSets": []
  },
  "risk": [
    "network-read",
    "account-mutation",
    "settings-storage",
    "packaging"
  ],
  "ownership": {
    "classPrefixes": [
      "Lthreadsmod/autoblock/AutoBlockSync",
      "Lthreadsmod/autoblock/BlockDiagnostic",
      "Lthreadsmod/autoblock/BlockLimits",
      "Lthreadsmod/autoblock/BlockLimitsStore",
