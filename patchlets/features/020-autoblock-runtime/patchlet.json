      "Lthreadsmod/autoblock/ManualBlockCallback",
      "Lthreadsmod/autoblock/ObjectFetcher",
      "Lthreadsmod/autoblock/ModStateStore",
      "Lthreadsmod/bootstrap/ModBootstrap",
      "Lnet/i2p/crypto/eddsa/"
    ],
    "classDescriptors": [
      "Lthreadsmod/autoblock/AutoBlockSync;",
      "Lthreadsmod/autoblock/BlockDiagnostic;",
      "Lthreadsmod/autoblock/BlockLimits;",
      "Lthreadsmod/autoblock/BlockLimitsStore;",
      "Lthreadsmod/autoblock/BlocklistStore;",
