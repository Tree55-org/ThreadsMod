      "limit_automatic_min_delay_ms",
      "limit_automatic_max_delay_ms",
      "limit_automatic_per_hour",
      "limit_target_budget",
      "limit_total_per_hour",
      "limit_total_per_day",
      "limit_max_per_run"
    ],
    "databaseSchemas": [
      "database:threadsmod_blocklist.db:v3",
      "migration:threadsmod_blocklist.db:v1-to-v2",
      "migration:threadsmod_blocklist.db:v2-to-v3",
